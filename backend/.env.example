# LLM Provider: openai / anthropic / qwen / kimi / gemini
LLM_PROVIDER=qwen

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# Qwen (DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embedding
# By default this uses QWEN_API_KEY + QWEN_BASE_URL with text-embedding-v4.
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Milvus
# Local Milvus Lite file by default. Use http://localhost:19530 for a standalone server.
MILVUS_URI=
MILVUS_COLLECTION=papernote_blocks
MILVUS_GRPC_KEEPALIVE_TIME_MS=120000
MILVUS_GRPC_KEEPALIVE_TIMEOUT_MS=20000
MILVUS_GRPC_KEEPALIVE_PERMIT_WITHOUT_CALLS=false

# Multimodal semantic enrichment
ENABLE_MULTIMODAL_ANSWERS=true
MULTIMODAL_ANSWER_IMAGE_LIMIT=4
ENABLE_MULTIMODAL_ENRICHMENT=true
MULTIMODAL_ENRICHMENT_LLM_LIMIT=8

# Agentic RAG (superMew-compatible backend ideas, PaperNote preprocessing retained)
AGENTIC_RAG_ENABLED=true
AGENTIC_MILVUS_COLLECTION_PREFIX=papernote_agentic_blocks
BM25_STATE_PATH=
DENSE_EMBEDDING_DIM=1024
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
AGENTIC_CANDIDATE_MULTIPLIER=3
RAG_GRADE_MODEL=
RAG_MAX_REWRITES=1
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12

# Harness agent tools and GSSC context builder
ENABLE_RESEARCH_TOOL=true
TAVILY_API_KEY=
TAVILY_RESEARCH_ENDPOINT=https://api.tavily.com/research
TAVILY_RESEARCH_MODEL=auto
TAVILY_RESEARCH_CITATION_FORMAT=numbered
TAVILY_RESEARCH_MAX_POLLS=8
TAVILY_RESEARCH_POLL_INTERVAL_SECONDS=2
CONTEXT_MAX_TOKENS=5000
CONTEXT_RESERVE_RATIO=0.2
CONTEXT_MIN_RELEVANCE=0.1
CONTEXT_ENABLE_COMPRESSION=true
CONTEXT_RECENCY_WEIGHT=0.3
CONTEXT_RELEVANCE_WEIGHT=0.7
NOTE_WORKSPACE_DIR=

# Optional rerank API. Leave blank to auto-degrade without rerank.
# qwen3-vl-rerank uses the DashScope rerank endpoint and can reuse QWEN_API_KEY.
RERANK_MODEL=qwen3-vl-rerank
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=${QWEN_API_KEY}

# MinerU API
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
ENABLE_MINERU_FIGURE_CROPS=true
DELETE_MINERU_RAW_IMAGES_AFTER_FIGURE_CROPS=true
FIGURE_CROP_DPI=220
FIGURE_CROP_PADDING=0.012
