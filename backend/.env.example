# LLM Provider: openai / anthropic / qwen / kimi / gemini
LLM_PROVIDER=qwen

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# Qwen (DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embedding
# By default this uses QWEN_API_KEY + QWEN_BASE_URL with text-embedding-v4.
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Milvus
# Local Milvus Lite file by default. Use http://localhost:19530 for a standalone server.
MILVUS_URI=
MILVUS_COLLECTION=papernote_blocks

# Multimodal semantic enrichment
ENABLE_MULTIMODAL_ENRICHMENT=true
MULTIMODAL_ENRICHMENT_LLM_LIMIT=8

# MinerU API
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
